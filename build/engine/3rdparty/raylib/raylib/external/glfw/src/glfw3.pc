prefix=D:/Projects/RayForge
exec_prefix=${prefix}
includedir=D:/Projects/RayForge/include
libdir=D:/Projects/RayForge/lib

Name: GLFW
Description: A multi-platform library for OpenGL, window and input
Version: 3.5.1
URL: https://www.glfw.org/
Requires.private: 
Libs: -L${libdir} -lglfw3
Libs.private: -lgdi32
Cflags: -I${includedir}
